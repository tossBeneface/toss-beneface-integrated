# Python 3.10 기반 이미지 사용
FROM python:3.10

# 작업 디렉토리 설정
WORKDIR /app

# 필수 패키지 설치
RUN apt-get update && apt-get install -y \
    cmake \
    curl \
    build-essential \
    libopenblas-dev \
    liblapack-dev \
    libx11-dev \
    libboost-python-dev \
    libboost-thread-dev \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

# Python 패키지 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install python-multipart
# 애플리케이션 코드 복사
COPY . .
RUN pip install --no-cache-dir maturin \
    && python -m maturin build --manifest-path rust/card_benefit_engine/Cargo.toml --release \
    && pip install --no-cache-dir $(find rust/card_benefit_engine/target/wheels -maxdepth 1 -name '*manylinux*.whl' | head -n 1)

EXPOSE 8000
# Uvicorn을 사용하여 FastAPI 애플리케이션 실행
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
