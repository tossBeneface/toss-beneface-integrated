# syntax=docker/dockerfile:1.7
FROM python:3.10-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    cmake \
    curl \
    build-essential \
    libopenblas-dev \
    liblapack-dev \
    libx11-dev \
    libboost-python-dev \
    libboost-thread-dev \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

COPY protos ./protos
RUN python -m grpc_tools.protoc \
    -I protos \
    --python_out . \
    --grpc_python_out . \
    protos/card_benefit.proto

COPY rust/card_benefit_engine ./rust/card_benefit_engine
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/app/rust/card_benefit_engine/target \
    pip install "maturin>=1.13,<2" \
    && python -m maturin build --manifest-path rust/card_benefit_engine/Cargo.toml --release \
    && pip install "$(find rust/card_benefit_engine/target/wheels -maxdepth 1 -name '*manylinux*.whl' | head -n 1)"

COPY . .

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
